@startuml CU15_Diagrama_de_Comunicacion
' ==========================================
' Estilos y Configuración General
' ==========================================
skinparam style strictuml
skinparam handwritten false
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12

' ==========================================
' Participantes (distribución horizontal:
' Actor -> Boundary -> Control -> Entities)
' ==========================================
actor ":Cliente" as cliente
boundary ":CartPageComponent" as ui
control ":CartController" as ctrl
entity ":Variante" as entVariante
entity ":Inventario" as entInventario
entity ":Carrito" as entCarrito
entity ":ItemCarrito" as entItem

' Enlaces ocultos para forzar el orden horizontal de izquierda a derecha
cliente -[hidden]right- ui
ui -[hidden]right- ctrl
ctrl -[hidden]right- entVariante
entVariante -[hidden]right- entInventario
entInventario -[hidden]right- entCarrito
entCarrito -[hidden]right- entItem

' ==========================================
' Mensajes numerados (funciones reales, sin parámetros)
' Los retornos de las entidades son implícitos (UML 2.5+,
' las entidades no envían mensajes de vuelta al controlador)
' ==========================================
cliente -- ui : "1: agregarProductoAlCarrito()"
ui -- ctrl : "1.1: addCartItem()"
ctrl -- entVariante : "1.2: obtenerDatosVariante()"
ctrl -- entInventario : "1.3: verificarStockDisponible()"
ctrl -- entCarrito : "1.4: obtenerOCrearCarrito()"
ctrl -- entItem : "1.5: agregarOActualizarItem()"
ctrl -- ui : "1.6: mostrarCarritoActualizado()"
ui -- cliente : "1.7: renderizarCarritoActualizado()"

cliente -- ui : "2: modificarCantidadProducto()"
ui -- ctrl : "2.1: updateCartItem()"
ctrl -- entInventario : "2.2: verificarStockDisponible()"
ctrl -- entItem : "2.3: actualizarCantidadItem()"
ctrl -- ui : "2.4: mostrarCarritoActualizado()"
ui -- cliente : "2.5: renderizarCarritoActualizado()"

@enduml
