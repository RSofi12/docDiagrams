@startuml CU18_Diagrama_de_Comunicacion
' ==========================================
' Estilos y Configuración General
' ==========================================
skinparam style strictuml
skinparam handwritten false
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12

' ==========================================
' Participantes (distribución horizontal:
' Actor -> Boundary -> Control -> Entities)
' ==========================================
actor ":Cajero" as cajero
boundary ":SalesPageComponent" as ui
control ":SalesController" as ctrl
entity ":Sucursal" as entSucursal
entity ":Reserva" as entReserva
entity ":Variante" as entVariante
entity ":Inventario" as entInventario
entity ":Venta" as entVenta
entity ":DetalleVenta" as entDetalle
entity ":Comprobante" as entComprobante

' Enlaces ocultos para forzar el orden horizontal de izquierda a derecha
cajero -[hidden]right- ui
ui -[hidden]right- ctrl
ctrl -[hidden]right- entSucursal
entSucursal -[hidden]right- entReserva
entReserva -[hidden]right- entVariante
entVariante -[hidden]right- entInventario
entInventario -[hidden]right- entVenta
entVenta -[hidden]right- entDetalle
entDetalle -[hidden]right- entComprobante

' ==========================================
' Mensajes numerados (funciones reales, sin parámetros)
' Los retornos de las entidades son implícitos (UML 2.5+,
' las entidades no envían mensajes de vuelta al controlador)
' ==========================================
cajero -- ui : "1: consultarVentasSucursal()"
ui -- ctrl : "1.1: list_sales_by_branch()"
ctrl -- entSucursal : "1.2: verificarSucursal()"
ctrl -- entVenta : "1.3: obtenerVentasPorSucursal()"
ctrl -- ui : "1.4: mostrarVentasSucursal()"
ui -- cajero : "1.5: renderizarVentasSucursal()"

cajero -- ui : "2: registrarVentaPresencial()"
ui -- ctrl : "2.1: create_sale()"
ctrl -- entSucursal : "2.2: verificarSucursal()"
ctrl -- entReserva : "2.3: _resolve_items()"
ctrl -- entVariante : "2.4: obtenerDatosVariante()"
ctrl -- entInventario : "2.5: actualizarStockYMovimiento()"
ctrl -- entVenta : "2.6: _create_sale_from_items()"
ctrl -- entDetalle : "2.7: agregarDetallesVenta()"
ctrl -- entComprobante : "2.8: generarComprobanteVenta()"
ctrl -- ui : "2.9: mostrarConfirmacionVenta()"
ui -- cajero : "2.10: renderizarComprobanteVenta()"

@enduml
