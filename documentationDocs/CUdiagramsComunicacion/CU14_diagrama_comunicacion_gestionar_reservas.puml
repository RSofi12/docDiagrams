@startuml CU14_Diagrama_de_Comunicacion
' ==========================================
' Estilos y Configuración General
' ==========================================
skinparam style strictuml
skinparam handwritten false
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12

' ==========================================
' Participantes (distribución horizontal:
' Actor -> Boundary -> Control -> Entities)
' ==========================================
actor ":Cliente" as cliente
boundary ":ReservationsPageComponent" as ui
control ":ReservationController" as ctrl
entity ":Sucursal" as entSucursal
entity ":Variante" as entVariante
entity ":Inventario" as entInventario
entity ":Reserva" as entReserva
entity ":DetalleReserva" as entDetalle

' Enlaces ocultos para forzar el orden horizontal de izquierda a derecha
cliente -[hidden]right- ui
ui -[hidden]right- ctrl
ctrl -[hidden]right- entSucursal
entSucursal -[hidden]right- entVariante
entVariante -[hidden]right- entInventario
entInventario -[hidden]right- entReserva
entReserva -[hidden]right- entDetalle

' ==========================================
' Mensajes numerados (funciones reales, sin parámetros)
' Los retornos de las entidades son implícitos (UML 2.5+,
' las entidades no envían mensajes de vuelta al controlador)
' ==========================================
cliente -- ui : "1: seleccionarPrendasYSucursal()"
ui -- ctrl : "1.1: createReservation()"
ctrl -- entSucursal : "1.2: obtenerSucursal()"
ctrl -- entVariante : "1.3: obtenerVariante()"
ctrl -- entInventario : "1.4: reservarStockDisponibilidad()"
ctrl -- entReserva : "1.5: crearReserva()"
ctrl -- entDetalle : "1.6: agregarDetalleReserva()"
ctrl -- ui : "1.7: mostrarReservaCreada()"
ui -- cliente : "1.8: renderizarReservaCreada()"

cliente -- ui : "2: solicitarCancelacionReserva()"
ui -- ctrl : "2.1: cancelReservation()"
ctrl -- entReserva : "2.2: actualizarEstadoCancelado()"
ctrl -- entInventario : "2.3: liberarStockReservado()"
ctrl -- ui : "2.4: mostrarReservaCancelada()"
ui -- cliente : "2.5: renderizarCancelacionReserva()"

@enduml
