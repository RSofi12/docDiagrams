@startuml CU06_Diagrama_de_Comunicacion
' ==========================================
' Estilos y Configuración General
' ==========================================
skinparam style strictuml
skinparam handwritten false
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12

' ==========================================
' Participantes (distribución horizontal:
' Actor -> Boundary -> Control -> Entities)
' ==========================================
actor ":Cliente" as cliente
boundary ":ProfilePageComponent" as ui
control ":UserController" as ctrl
entity ":Usuario" as entUsuario

' Enlaces ocultos para forzar el orden horizontal de izquierda a derecha
cliente -[hidden]right- ui
ui -[hidden]right- ctrl
ctrl -[hidden]right- entUsuario

' ==========================================
' Mensajes numerados (funciones reales, sin parámetros)
' Los retornos de las entidades son implícitos (UML 2.5+,
' las entidades no envían mensajes de vuelta al controlador)
' ==========================================
cliente -- ui : "1: consultarPerfil()"
ui -- ctrl : "1.1: getMe()"
ctrl -- entUsuario : "1.2: get_current_user()"
ctrl -- ui : "1.3: mostrarPerfil()"
ui -- cliente : "1.4: renderizarPerfil()"

cliente -- ui : "2: actualizarPerfil()"
ui -- ctrl : "2.1: updateMe()"
ctrl -- entUsuario : "2.2: update_user_profile()"
ctrl -- ui : "2.3: mostrarPerfilActualizado()"
ui -- cliente : "2.4: renderizarPerfilActualizado()"

@enduml
