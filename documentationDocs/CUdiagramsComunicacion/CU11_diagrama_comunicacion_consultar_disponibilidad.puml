@startuml CU11_Diagrama_de_Comunicacion
' ==========================================
' Estilos y Configuración General
' ==========================================
skinparam style strictuml
skinparam handwritten false
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12

' ==========================================
' Participantes (distribución horizontal:
' Actor -> Boundary -> Control -> Entities)
' ==========================================
actor ":Cliente" as cliente
boundary ":CatalogPageComponent" as ui
control ":CatalogController" as ctrl
entity ":Sucursal" as entSucursal
entity ":Producto" as entProducto
entity ":Talla" as entTalla
entity ":Color" as entColor
entity ":Variante" as entVariante
entity ":Inventario" as entInventario

' Enlaces ocultos para forzar el orden horizontal de izquierda a derecha
cliente -[hidden]right- ui
ui -[hidden]right- ctrl
ctrl -[hidden]right- entSucursal
entSucursal -[hidden]right- entProducto
entProducto -[hidden]right- entTalla
entTalla -[hidden]right- entColor
entColor -[hidden]right- entVariante
entVariante -[hidden]right- entInventario

' ==========================================
' Mensajes numerados (funciones reales, sin parámetros)
' Los retornos de las entidades son implícitos (UML 2.5+,
' las entidades no envían mensajes de vuelta al controlador)
' ==========================================
cliente -- ui : "1: consultarDisponibilidadPorSucursal()"
ui -- ctrl : "1.1: getAvailability()"
ctrl -- entSucursal : "1.2: obtenerSucursalActiva()"
ctrl -- entProducto : "1.3: obtenerDatosProductos()"
ctrl -- entTalla : "1.4: obtenerTalla()"
ctrl -- entColor : "1.5: obtenerColor()"
ctrl -- entVariante : "1.6: obtenerVariantesPorFiltro()"
ctrl -- entInventario : "1.7: consultarStockPorSucursal()"
ctrl -- ui : "1.8: mostrarDisponibilidadStock()"
ui -- cliente : "1.9: renderizarDisponibilidadStock()"

@enduml
